<script>
(function(){
'use strict';
var reduced=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
function $(id){return document.getElementById(id);}

/* печать */
Array.prototype.forEach.call(document.querySelectorAll('.js-print'),function(b){b.addEventListener('click',function(){window.print();});});

/* навигация + появление */
var links=document.querySelectorAll('.nav-link');
if('IntersectionObserver' in window){
  var spy=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){Array.prototype.forEach.call(links,function(l){l.classList.toggle('active',l.getAttribute('data-target')===e.target.id);});}});},{rootMargin:'-35% 0px -55% 0px'});
  ['zamysel','plan','zadanie','temy','tablitsa','otsenka','final'].forEach(function(id){var el=$(id);if(el)spy.observe(el);});
  var rev=document.querySelectorAll('.reveal');
  Array.prototype.forEach.call(rev,function(el){el.classList.add('pre');});
  var io=new IntersectionObserver(function(en){en.forEach(function(e){if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.1,rootMargin:'0px 0px -6% 0px'});
  Array.prototype.forEach.call(rev,function(el){io.observe(el);});
}
/* параллакс компаса */
var compass=$('compassRose'),b1=document.querySelector('.blob.b1'),b2=document.querySelector('.blob.b2');
if(!reduced){
  var tick=false;
  window.addEventListener('scroll',function(){
    if(tick)return;tick=true;
    requestAnimationFrame(function(){
      var y=window.scrollY;
      if(y<window.innerHeight*1.3){
        if(compass)compass.style.transform='rotate('+(y*0.035)+'deg)';
        if(b1)b1.style.marginTop=(y*0.08)+'px';
        if(b2)b2.style.marginBottom=(-y*0.05)+'px';
      }
      tick=false;
    });
  },{passive:true});
}else{
  Array.prototype.forEach.call(document.querySelectorAll('animateMotion'),function(a){a.parentNode.removeChild(a);});
}

/* памятка с сохранением */
var CKEY='mir18-checklist-v1';
var boxes=[].slice.call(document.querySelectorAll('#chkList input'));
function loadChk(){try{return JSON.parse(localStorage.getItem(CKEY))||{};}catch(e){return {};}}
function saveChk(o){try{localStorage.setItem(CKEY,JSON.stringify(o));}catch(e){}}
var chkState=loadChk();
function paintChk(){
  var n=boxes.filter(function(b){return b.checked;}).length;
  $('chkProg').textContent='Готовность '+n+' / '+boxes.length;
  $('chkBar').style.width=(n/boxes.length*100)+'%';
  $('chkNote').textContent=n===boxes.length?'Команда готова к выступлению. Удачи на уроке!':'Отметки сохраняются в этом браузере — можно возвращаться к памятке. При печати памятка выходит с пустыми квадратиками.';
}
boxes.forEach(function(b){
  b.checked=!!chkState[b.getAttribute('data-k')];
  b.addEventListener('change',function(){chkState[b.getAttribute('data-k')]=b.checked;saveChk(chkState);paintChk();});
});
$('chkReset').addEventListener('click',function(){chkState={};saveChk(chkState);boxes.forEach(function(b){b.checked=false;});paintChk();});
paintChk();

/* репетиционный таймер */
var BLOCKS=[
 {n:'Визитная карточка',w:2,c:'#C0392B'},
 {n:'Власть и общество',w:3,c:'#D98E2B'},
 {n:'Экономика и быт',w:3,c:'#D9A441'},
 {n:'Страна и мир',w:4,c:'#1F7A8C'},
 {n:'Итог века',w:2,c:'#2F7D6D'},
 {n:'Живой свидетель',w:2,c:'#B04A6E'},
 {n:'Интерактив с классом',w:3,c:'#2E5E8C'}
];
var W=BLOCKS.reduce(function(s,b){return s+b.w;},0);
var totalMin=17,total=totalMin*60,elapsed=0,running=false,tid=null,last=0;
function mmss(s){s=Math.max(0,Math.round(s));var m=Math.floor(s/60),x=s%60;return m+':'+(x<10?'0':'')+x;}
function spans(){var acc=0;return BLOCKS.map(function(b){var d=total*b.w/W,o={s:acc,e:acc+d,d:d,b:b};acc+=d;return o;});}
function buildPlan(){
  var sp=spans(),h='';
  sp.forEach(function(o,i){
    h+='<li data-i="'+i+'" style="--c:'+o.b.c+'"><i></i><span class="rn">'+(i+1)+'. '+o.b.n+'</span><span class="rt">'+mmss(o.s)+' → '+mmss(o.e)+' · '+mmss(o.d)+'</span></li>';
  });
  $('rPlan').innerHTML=h;
  var bar='<div class="rneedle" id="rNeedle" style="left:0"></div>';
  sp.forEach(function(o){bar+='<span style="flex:'+o.b.w+';background:'+o.b.c+'"></span>';});
  $('rBar').innerHTML=bar;
}
function paint(){
  var sp=spans(),left=total-elapsed,idx=-1;
  for(var i=0;i<sp.length;i++){if(elapsed>=sp[i].s&&elapsed<sp[i].e){idx=i;break;}}
  if(elapsed>=total)idx=sp.length-1;
  $('rDigits').textContent=mmss(left);
  var rows=$('rPlan').children;
  for(var j=0;j<rows.length;j++)rows[j].classList.toggle('now',running&&j===idx);
  var needle=$('rNeedle');
  if(needle)needle.style.left=Math.min(100,elapsed/total*100)+'%';
  if(!running&&elapsed===0){$('rNowName').textContent='Готовы к прогону';$('rNowHint').textContent='Регламент '+totalMin+' минут · 7 блоков';}
  else if(idx>=0){$('rNowName').textContent=(running?'Сейчас: ':'Пауза: ')+sp[idx].b.n;$('rNowHint').textContent='Блок '+(idx+1)+' из 7 · в блоке осталось '+mmss(sp[idx].e-elapsed);}
}
function setBtn(){
  $('rStart').innerHTML=running?'<svg class="ic"><use href="#i-pause"/></svg><span>Пауза</span>':'<svg class="ic"><use href="#i-play"/></svg><span>'+(elapsed>0?'Дальше':'Старт')+'</span>';
}
function stop(){running=false;if(tid){clearInterval(tid);tid=null;}setBtn();}
function tick(){
  var now=performance.now();elapsed+=(now-last)/1000;last=now;
  if(elapsed>=total){elapsed=total;stop();$('rDone').hidden=false;}
  paint();
}
$('rStart').addEventListener('click',function(){
  if(running){stop();paint();return;}
  if(elapsed>=total){elapsed=0;$('rDone').hidden=true;}
  running=true;last=performance.now();$('rDone').hidden=true;
  if(tid)clearInterval(tid);
  tid=setInterval(tick,200);setBtn();paint();
});
$('rReset').addEventListener('click',function(){stop();elapsed=0;$('rDone').hidden=true;paint();});
Array.prototype.forEach.call(document.querySelectorAll('.rpre'),function(b){
  b.addEventListener('click',function(){
    Array.prototype.forEach.call(document.querySelectorAll('.rpre'),function(x){x.classList.remove('on');});
    b.classList.add('on');totalMin=+b.getAttribute('data-min');total=totalMin*60;
    stop();elapsed=0;$('rDone').hidden=true;buildPlan();paint();
  });
});
buildPlan();paint();setBtn();
window.addEventListener('beforeprint',function(){stop();paint();});
})();
</script>
</body>
</html>
